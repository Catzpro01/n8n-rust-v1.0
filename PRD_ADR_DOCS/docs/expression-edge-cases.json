  "test_cases": [
    {"id": "TC-001", "cat": "type_coercion", "expr": "'1' + 1", "expected": "'11'", "risk": "HIGH", "note": "String+number coercion - must match V8 exactly"},
    {"id": "TC-002", "cat": "type_coercion", "expr": "1 + '1'", "expected": "'11'", "risk": "HIGH", "note": "Number+string coercion"},
    {"id": "TC-003", "cat": "type_coercion", "expr": "'5' - 3", "expected": "2", "risk": "HIGH", "note": "String minus number - implicit toNumber"},
    {"id": "TC-004", "cat": "type_coercion", "expr": "true + 1", "expected": "2", "risk": "MED", "note": "Boolean+number coercion"},
    {"id": "TC-005", "cat": "type_coercion", "expr": "false + 1", "expected": "1", "risk": "MED", "note": "Boolean+number coercion"},
    {"id": "TC-006", "cat": "type_coercion", "expr": "null + 1", "expected": "1", "risk": "MED", "note": "null coerces to 0"},
    {"id": "TC-007", "cat": "type_coercion", "expr": "undefined + 1", "expected": "NaN", "risk": "MED", "note": "undefined coerces to NaN"},
    {"id": "TC-008", "cat": "type_coercion", "expr": "[] + []", "expected": "''", "risk": "HIGH", "note": "Empty array concat - both toString to empty"},
    {"id": "TC-009", "cat": "type_coercion", "expr": "[] + {}", "expected": "'[object Object]'", "risk": "HIGH", "note": "Array+object coercion"},
    {"id": "TC-010", "cat": "type_coercion", "expr": "({}) + []", "expected": "'[object Object]'", "risk": "HIGH", "note": "Object+array coercion - wrapped in parens to ensure object context"},
    {"id": "TC-011", "cat": "type_coercion", "expr": "'0' == false", "expected": "true", "risk": "HIGH", "note": "Loose equality coercion chain"},
    {"id": "TC-012", "cat": "type_coercion", "expr": "'' == false", "expected": "true", "risk": "HIGH", "note": "Empty string loose equality with false"},
    {"id": "TC-013", "cat": "type_coercion", "expr": "null == undefined", "expected": "true", "risk": "MED", "note": "null and undefined are loosely equal"},
    {"id": "TC-014", "cat": "type_coercion", "expr": "null == 0", "expected": "false", "risk": "MED", "note": "null is NOT coerced to 0 in =="},
    {"id": "TC-015", "cat": "type_coercion", "expr": "NaN === NaN", "expected": "false", "risk": "MED", "note": "NaN is not equal to itself"},

