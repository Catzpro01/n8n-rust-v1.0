{
  "id": "bloomberg-multi-asset-radar",
  "version": "1.0.0",
  "name": "Bloomberg Multi-Asset Morning Radar (Active)",
  "type": "active",
  "category": "finance_macro",
  "author": "agent4",
  "license": "MIT",
  "engine_compatibility": ">=0.1.0",
  "documentation": {
    "cara_kerja": "Workflow aktif terjadwal (ScheduleTrigger v2, ekspresi cron deterministik 30 7 * * 1-5, TZ Asia/Jakarta): tarik S&P 500 via stooq CSV, USD/IDR via open.er-api.com, harga BTC/ETH via CoinGecko Simple Price; Code node menormalkan ketiganya ke SATU objek JSON kanonik; If node membunyikan flag alarm bila USD/IDR > ambang. Semua fetch punya timeout + continue-on-error sehingga feed mati tidak mematikan engine.",
    "fungsi": "Menghasilkan ringkasan pasar multi-aset pagi (indeks, FX, kripto) dalam satu objek kanonik + flag risk_alert untuk ambang yang bisa diedit pengguna.",
    "tujuan": "Memberi sinyal pembuka pasar harian bagi trader/analis tanpa kunci API berbayar, deterministik dan hemat memori (0 buffer besar, streaming teks kecil)."
  },
  "pinning": {
    "type": "schema-pin",
    "schema_hash": "sha256:0ce38a770a881dccbad38822a6345b84e74fa70fff324806481e586180356806",
    "expected_keys": [
      "spx_close",
      "spx_chg_pct",
      "usdidr",
      "btc_usd",
      "eth_usd",
      "risk_alert",
      "fetched_at"
    ],
    "algorithm": "sha256",
    "hash_domain": "canon-json-sorted:expected_keys+outputs"
  },
  "inputs": {
    "usdidr_alert_threshold": {
      "type": "number",
      "default": 16500,
      "description": "Ambang alarm USD/IDR"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Jakarta"
    }
  },
  "outputs": {
    "spx_close": {
      "type": "number"
    },
    "spx_chg_pct": {
      "type": "number"
    },
    "usdidr": {
      "type": "number"
    },
    "btc_usd": {
      "type": "number"
    },
    "eth_usd": {
      "type": "number"
    },
    "risk_alert": {
      "type": "boolean"
    },
    "fetched_at": {
      "type": "string"
    }
  },
  "dag": {
    "nodes": [
      {
        "id": "sticky_guide",
        "type": "n8n-nodes-base.stickyNote",
        "name": "Panduan Radar",
        "parameters": {
          "content": "## [CARA KERJA]\nJadwal 07:30 WIB hari kerja -> ambil S&P 500 (stooq CSV), USD/IDR (open.er-api.com), BTC/ETH (CoinGecko) -> normalisasi kanonik -> ambang alarm.\n## [FUNGSI]\nRingkasan pasar multi-aset pagi hari + flag alarm risiko.\n## [TUJUAN]\nKeputusan alokasi harian cepat ala Bloomberg Terminal, deterministik & tanpa kunci API."
        }
      },
      {
        "id": "sched_radar",
        "type": "n8n-nodes-base.scheduleTrigger",
        "name": "Jadwal 07:30 WIB",
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "30 7 * * 1-5"
              }
            ]
          }
        }
      },
      {
        "id": "fx_spx",
        "type": "n8n-nodes-base.httpRequest",
        "name": "S&P 500 (Stooq)",
        "parameters": {
          "method": "GET",
          "url": "https://stooq.com/q/l/?s=^spx&f=sd2t2ohlcv&h&e=csv",
          "responseFormat": "text",
          "onError": "continueRegularOutput",
          "options": {
            "timeout": 20000
          }
        }
      },
      {
        "id": "fx_usdidr",
        "type": "n8n-nodes-base.httpRequest",
        "name": "USD/IDR",
        "parameters": {
          "method": "GET",
          "url": "https://open.er-api.com/v6/latest/USD",
          "responseFormat": "json",
          "onError": "continueRegularOutput",
          "options": {
            "timeout": 20000
          }
        }
      },
      {
        "id": "fx_crypto",
        "type": "n8n-nodes-base.httpRequest",
        "name": "BTC/ETH (CoinGecko)",
        "parameters": {
          "method": "GET",
          "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd",
          "responseFormat": "json",
          "onError": "continueRegularOutput",
          "options": {
            "timeout": 20000
          }
        }
      },
      {
        "id": "norm_canon",
        "type": "n8n-nodes-base.code",
        "name": "Normalisasi Kanonik",
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// parse CSV stooq + JSON fx -> objek kanonik {spx_close, spx_chg_pct, usdidr, btc_usd, eth_usd, fetched_at} -> schema-pin keys stabil"
        }
      },
      {
        "id": "gate_alarm",
        "type": "n8n-nodes-base.if",
        "name": "Ambang Alarm",
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true
            },
            "conditions": [
              {
                "leftValue": "={{ $json.usdidr }}",
                "leftValueType": "number",
                "operation": "larger",
                "rightValue": 16500
              }
            ]
          }
        }
      },
      {
        "id": "out_ok",
        "type": "n8n-nodes-base.noOp",
        "name": "Lanjut Normal"
      },
      {
        "id": "out_alarm",
        "type": "n8n-nodes-base.set",
        "name": "Tandai Alarm",
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "name": "risk_alert",
                "type": "boolean",
                "value": true
              }
            ]
          }
        }
      }
    ],
    "connections": {
      "sched_radar": {
        "main": [
          [
            {
              "node": "fx_spx",
              "type": "main",
              "index": 0
            },
            {
              "node": "fx_usdidr",
              "type": "main",
              "index": 0
            },
            {
              "node": "fx_crypto",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "fx_spx": {
        "main": [
          [
            {
              "node": "norm_canon",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "fx_usdidr": {
        "main": [
          [
            {
              "node": "norm_canon",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "fx_crypto": {
        "main": [
          [
            {
              "node": "norm_canon",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "norm_canon": {
        "main": [
          [
            {
              "node": "gate_alarm",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "gate_alarm": {
        "main": [
          [
            {
              "node": "out_ok",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "out_alarm",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }
}