{
  "id": "bloomberg-sec-edgar-capsule",
  "version": "1.0.0",
  "name": "SEC EDGAR 10-K Risk Capsule (Passive 1-Node)",
  "type": "passive",
  "category": "finance_equities",
  "author": "agent4",
  "license": "MIT",
  "engine_compatibility": ">=0.1.0",
  "documentation": {
    "cara_kerja": "Kapsul black-box: input ticker -> tarik pengajuan SEC 10-K terbaru via EDGAR REST (data.sec.gov), ekstrak Item 1A Risk Factors, tokenisasi + skor sentimen leksikon risiko, agregasi jadi 1 objek JSON kanonik.",
    "fungsi": "Mengemas pipeline uji tuntas fundamental (unduh EDGAR + ekstraksi risiko + skor sentimen) menjadi SATU node: input ticker, output ringkasan risiko terstruktur.",
    "tujuan": "Memberi analis fundamental deteksi risiko pengungkapan korporat tanpa menyusun graf workflow apa pun."
  },
  "pinning": {
    "type": "schema-pin",
    "schema_hash": "blake3:sec_edgar_capsule_v1",
    "expected_keys": [
      "ticker",
      "company_name",
      "risk_factors_count",
      "composite_sentiment_score",
      "sentiment_label",
      "generated_at"
    ]
  },
  "inputs": {
    "ticker": {
      "type": "string",
      "required": true,
      "default": "AAPL"
    },
    "lookback_years": {
      "type": "integer",
      "default": 3
    },
    "sentiment_threshold": {
      "type": "number",
      "default": -0.2
    }
  },
  "outputs": {
    "company_name": {
      "type": "string"
    },
    "risk_factors_count": {
      "type": "number"
    },
    "composite_sentiment_score": {
      "type": "number"
    },
    "sentiment_label": {
      "type": "string"
    },
    "top_risk_factor": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    }
  },
  "dag": {
    "nodes": [
      {
        "id": "capsule_ingest",
        "type": "n8n-nodes-base.httpRequest",
        "name": "EDGAR 10-K Ingest",
        "parameters": {
          "method": "GET",
          "url": "https://data.sec.gov/submissions/CIK{{ $json.cik }}.json",
          "onError": "continueRegularOutput",
          "options": {
            "timeout": 30000
          }
        }
      },
      {
        "id": "capsule_parse",
        "type": "n8n-nodes-base.code",
        "name": "Risk Factor Parser",
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// ambil Item 1A -> daftar risk factor -> skor leksikon risiko -> objek kanonik"
        }
      },
      {
        "id": "capsule_out",
        "type": "n8n-nodes-base.set",
        "name": "Capsule Output",
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "name": "generated_at",
                "type": "string",
                "value": "={{ $now.toISO() }}"
              }
            ]
          }
        }
      }
    ],
    "connections": {
      "capsule_ingest": {
        "main": [
          [
            {
              "node": "capsule_parse",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "capsule_parse": {
        "main": [
          [
            {
              "node": "capsule_out",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }
}